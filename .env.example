# cp .env.example .env をして、値を入れる。.env は Git に入れない(実行環境 5.2)

# Gateway と 3 つのサービスの間、record-service と master-service の間のサービス間キー。推測されにくい長い文字列にする
SERVICE_KEY=

# PostgreSQL の管理者。db/init/ の手順と、テスト用のデータベースの作り直しに使う。サービスは使わない
DB_USER=
DB_PASSWORD=

# サービスごとのデータベースの利用者の合言葉(nightreign_master、nightreign_record、nightreign_relic)
MASTER_DB_PASSWORD=
RECORD_DB_PASSWORD=
RELIC_DB_PASSWORD=

# Gateway が許すオリジン。省くと http://localhost:3000
CORS_ORIGINS=

# 管理用の鍵(16 文字以上)。/api/v1/admin の呼び出しに X-Admin-Key で付ける
ADMIN_KEY=
