# cp .env.example .env をして、値を入れる。.env は Git に入れない(実行環境 5.2)

# Gateway が発行する JWT の署名キー
JWT_SECRET=

# Gateway とバックエンドの間のサービス間キー。推測されにくい長い文字列にする
SERVICE_KEY=

# PostgreSQL の利用者と合言葉
DB_USER=
DB_PASSWORD=

# Gateway が許すオリジン。省くと http://localhost:3000
CORS_ORIGINS=

# 管理用の鍵(16 文字以上)。/api/v1/admin の呼び出しに X-Admin-Key で付ける
ADMIN_KEY=
