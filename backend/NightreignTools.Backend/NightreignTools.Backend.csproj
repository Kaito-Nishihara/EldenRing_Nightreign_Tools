<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 警告を誤りとして扱う(サービスの共通構成 5.2) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>NightreignTools.Backend</RootNamespace>
    <AssemblyName>NightreignTools.Backend</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NightreignTools.Backend.Tests" />
  </ItemGroup>

</Project>
