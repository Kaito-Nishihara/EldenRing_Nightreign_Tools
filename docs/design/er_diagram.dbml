// Elden Ring Nightreign Tools - ER図
// https://dbdiagram.io にペーストして使用する

Table bosses {
  id               varchar(50)  [pk, note: '例: gladius']
  name_ja          varchar(100) [not null]
  name_en          varchar(100)
  image_path       varchar(200) [note: 'ボス画像パス 例: /images/bosses/gladius.webp']
  is_dlc           boolean      [not null, default: false]
  unlock_condition varchar(200)
  created_at       timestamp    [not null, default: `CURRENT_TIMESTAMP`]
}

Table boss_weaknesses {
  id        serial      [pk]
  boss_id   varchar(50) [not null, ref: > bosses.id]
  attribute varchar(30) [not null, note: 'holy / fire / lightning / poison / madness / sleep']
}

Table jihen {
  id               varchar(50)  [pk, note: '例: crater']
  name_ja          varchar(100) [not null]
  image_path       varchar(200) [note: '地変画像パス 例: /images/jihen/crater.webp']
  area             varchar(50)  [not null]
  center_x         decimal(5,4) [not null, note: 'マップ上のX座標 0.0〜1.0']
  center_y         decimal(5,4) [not null, note: 'マップ上のY座標 0.0〜1.0']
  unlock_condition varchar(200)
  is_dlc           boolean      [not null, default: false]
  created_at       timestamp    [not null, default: `CURRENT_TIMESTAMP`]
}

Table shrink_zones {
  id         serial       [pk]
  name_ja    varchar(100) [not null]
  icon_path  varchar(200) [note: 'エリアアイコン画像パス']
  center_x   decimal(5,4) [not null, note: 'マップ上のX座標 0.0〜1.0']
  center_y   decimal(5,4) [not null, note: 'マップ上のY座標 0.0〜1.0']
  radius     decimal(5,4) [not null, note: '収縮円の半径']
  created_at timestamp    [not null, default: `CURRENT_TIMESTAMP`]
}

Table spawn_points {
  id               serial       [pk]
  name_ja          varchar(100) [not null]
  x                decimal(5,4) [not null]
  y                decimal(5,4) [not null]
  nearby_base_type varchar(30)  [not null, note: 'camp or church']
  created_at       timestamp    [not null, default: `CURRENT_TIMESTAMP`]
}

Table play_records {
  id             serial      [pk]
  boss_id        varchar(50) [not null, ref: > bosses.id]
  jihen_id       varchar(50) [ref: > jihen.id, note: 'NULLは地変なし']
  spawn_point_id integer     [ref: > spawn_points.id]
  note           text
  created_at     timestamp   [not null, default: `CURRENT_TIMESTAMP`]
}

Table shrink_entries {
  id             serial  [pk]
  play_record_id integer [not null, ref: > play_records.id]
  day            integer [not null, note: '1 or 2']
  phase          integer [not null, note: '1 or 2']
  zone_id        integer [not null, ref: > shrink_zones.id]

  indexes {
    (play_record_id, day, phase) [unique]
  }
}
