{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "record-patterns-route": {
        "ClusterId": "record-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v1/patterns/{**catch-all}"
        }
      },
      "record-play-records-route": {
        "ClusterId": "record-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/v1/play-records/{**catch-all}"
        }
      },
      "master-route": {
        "ClusterId": "master-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "record-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "Destinations": {
          "record": {
            "Address": "http://record-service:8082"
          }
        }
      },
      "master-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Destinations": {
          "master": {
            "Address": "http://master-service:8081"
          }
        }
      }
    }
  }
}
